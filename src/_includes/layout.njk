<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content="{{ description }}" />
        <title>{{ title }}</title>
        <link rel="stylesheet" href="{{ '/style.css' | url }}" />
    </head>
    <body>
        <header id="top">
            <h1>{{ title }}</h1>
        </header>
        <div id="layout">
            <nav aria-labelledby="contents-title" id="contents">
                <details open>
                    <summary id="contents-title">Contents</summary>
                    <ul role="list">
                        <li><a href="#introduction">Introduction</a></li>
                        <li>
                            <a href="#data-structures">Data Structures</a>
                            <ul role="list">
                                <li><a href="#arrays">Arrays</a></li>
                                <li>
                                    <a href="#linked-lists">Linked Lists</a>
                                </li>
                                <li><a href="#stacks">Stacks</a></li>
                                <li><a href="#queues">Queues</a></li>
                                <li><a href="#trees">Trees</a></li>
                                <li><a href="#graphs">Graphs</a></li>
                                <li>
                                    <a href="#advanced-data-structures"
                                        >Advanced Data Structures</a
                                    >
                                </li>
                            </ul>
                        </li>
                        <li>
                            <a href="#algorithms">Algorithms</a>
                            <ul role="list">
                                <li>
                                    <a href="#searching-algorithms"
                                        >Searching Algorithms</a
                                    >
                                    <ul role="list">
                                        <li>
                                            <a href="#linear-search"
                                                >Linear Search</a
                                            >
                                        </li>
                                        <li>
                                            <a href="#binary-search"
                                                >Binary Search</a
                                            >
                                        </li>
                                    </ul>
                                </li>
                                <li>
                                    <a href="#sorting-algorithms"
                                        >Sorting Algorithms</a
                                    >
                                    <ul role="list">
                                        <li>
                                            <a href="#bubble-sort"
                                                >Bubble Sort</a
                                            >
                                        </li>
                                        <li>
                                            <a href="#selection-sort"
                                                >Selection Sort</a
                                            >
                                        </li>
                                        <li>
                                            <a href="#insertion-sort"
                                                >Insertion Sort</a
                                            >
                                        </li>
                                        <li>
                                            <a href="#merge-sort">Merge Sort</a>
                                        </li>
                                        <li>
                                            <a href="#quick-sort">Quick Sort</a>
                                        </li>
                                    </ul>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </details>
            </nav>
            <main id="main-content" tabindex="-1">
                {{ content | safe }}
            </main>
        </div>
        <footer>
            <p><a href="#top">Back to top</a></p>
            <p>
                Adapted from the
                <a
                    href="https://www.geeksforgeeks.org/dsa/data-structures-algorithms-guide-for-developers/"
                    >here</a
                >.
            </p>
        </footer>
        <script>
            (() => {
                const toc = document.querySelector("#contents details");
                if (!toc) return;

                const mobile = window.matchMedia("(max-width: 60rem)");

                const syncToc = () => {
                    toc.open = !mobile.matches;
                };

                syncToc();
                mobile.addEventListener("change", syncToc);
            })();
        </script>
    </body>
</html>
